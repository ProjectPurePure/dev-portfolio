  display: grid;
  grid-template-columns: 1fr 0;
  grid-template-rows: auto;
  grid-template-areas: "content sticky-button";
  width: 100%;
  position: absolute;
  overflow-y: auto;
  background-color: #fff;
  top: 55px;
  padding: 24px 32px;
  box-sizing: border-box;
  height: calc(80vh - 55px);
  /*
  The \`transform: translateZ(0)\` property forces the browser to create a new layer to paint this element
  This addresses a problem in Microsoft Windows w/ Chrome with the scroll not working correctly when a user
  click-drags the scrollbar and it scrolls the background instead of the foreground. PLAN-513
  */
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
}
@media (max-width: 600px) {
  .amp-nav.amp-nav-adult .amp-mega-menu {
    padding: 24px 10px;
  }
}
.amp-nav.amp-nav-adult .amp-mega-menu .more-programs-box-asset:hover,
.amp-nav.amp-nav-adult .amp-mega-menu .amp-mega-menu-programs .asset:hover {
  color: #9c0d63;
}
.amp-nav.amp-nav-adult .amp-mega-menu .more-programs-box-asset:focus:not(:focus-visible) {
  outline: none;
}
.amp-nav.amp-nav-adult .amp-mega-menu .more-programs-box {
  max-width: 275px;
  padding: 36px;
  background: #f6f6f6;
  border-radius: 4.2px;
  height: fit-content;
}
@media (max-width: 600px) {
  .amp-nav.amp-nav-adult .amp-mega-menu .more-programs-box {
    padding: 24px 8px;
  }
}
.amp-nav.amp-nav-adult .amp-mega-menu .more-programs-box .more-programs-box-asset {
  margin-top: 24px;
  display: flex;
  align-items: center;
  text-decoration: none;
  color: #3b3b3b;
}
.amp-nav.amp-nav-adult .amp-mega-menu .more-programs-box .more-programs-box-asset:hover {
  color: #9c0d63;
}
.amp-nav.amp-nav-adult .amp-mega-menu .more-programs-box .more-programs-box-asset-image {
  width: 44px;
  height: 44px;
  border-radius: 3.2px;
}
.amp-nav.amp-nav-adult .amp-mega-menu .more-programs-box .more-programs-box-asset-name {
  margin-left: 11px;
  font-size: 15px;
}
.amp-nav.amp-nav-adult .amp-mega-menu .more-programs-box-title, .amp-nav.amp-nav-adult .amp-mega-menu .asset-title {
  font-size: 19px;
  font-weight: normal;
}
.amp-nav.amp-nav-adult .amp-mega-menu .amp-mega-menu-close {
  grid-area: sticky-button;
  align-self: start;
  justify-self: end;
  position: sticky;
  top: 0;
  width: 49px;
  height: 49px;
  border-radius: 50%;
  transition: background-color 0.3s ease-in-out;
  background: none;
  border: none;
  cursor: pointer;
  display: flex;
  justify-content: center;
  align-items: center;
}
.amp-nav.amp-nav-adult .amp-mega-menu .amp-mega-menu-close:hover {
  background-color: #f6f6f6;
}
.amp-nav.amp-nav-adult .amp-mega-menu .amp-mega-menu-close-image {
  width: 25px !important;
  height: 25px !important;
}
.amp-nav.amp-nav-adult .amp-mega-menu .amp-mega-menu-content {
  margin-top: 10px;
  grid-area: content;
  display: flex;
  justify-content: center;
}
.amp-nav.amp-nav-adult .amp-mega-menu .amp-mega-menu-programs {
  box-sizing: border-box;
  width: 90%;
  max-width: 958px;
  padding: 0 12px 0 40px;
}
@media (max-width: 600px) {
  .amp-nav.amp-nav-adult .amp-mega-menu .amp-mega-menu-programs {
    padding: 0 0 0 20px;
  }
}
.amp-nav.amp-nav-adult .amp-mega-menu .amp-mega-menu-programs .asset-container {
  display: flex;
  flex-wrap: wrap;
  margin: 24px 0;
}
.amp-nav.amp-nav-adult .amp-mega-menu .amp-mega-menu-programs .asset {
  width: 121px;
  display: flex;
  align-items: center;
  flex-direction: column;
  text-align: center;
  text-decoration: none;
  color: #3b3b3b;
  margin-right: 24px;
}
.amp-nav.amp-nav-adult .amp-mega-menu .amp-mega-menu-programs .asset:focus:not(:focus-visible) {
  outline: none;
}
.amp-nav.amp-nav-adult .amp-mega-menu .amp-mega-menu-programs .asset-image {
  width: 55px;
  height: 55px;
  border-radius: 3.2px;
}
.amp-nav.amp-nav-adult .amp-mega-menu .amp-mega-menu-programs .asset-name {
  font-size: 13px;
  margin: 10px 0 20px;
}
.amp-nav.amp-nav-adult .amp-mega-menu .amp-mega-menu-loader {
  background-color: #00101b;
  opacity: 0.4;
  width: 90px;
  height: 90px;
  border-radius: 12px;
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  margin: auto;
}
.amp-nav.amp-nav-adult .amp-mega-menu .amp-mega-menu-loader::before {
  content: url("data:image/svg+xml;base64,");
  height: 44px;
  left: calc(50% - 22px);
  position: absolute;
  top: calc(50% - 22px);
  width: 44px;
  animation: loader-spin 2s linear infinite;
  -moz-animation: loader-spin 2s linear infinite;
  -webkit-animation: loader-spin 2s linear infinite;
}
.amp-nav.amp-nav-adult .amp-mega-menu .amp-mega-menu-no-programs {
  position: absolute;
  top: 50%;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: center;
  color: #4d4d4f;
}
.amp-nav.amp-nav-adult .amp-mega-menu .amp-mega-menu-no-programs a {
  color: #9c0d63;
}
.amp-nav.amp-nav-adult .amp-mega-menu-overlay {
  position: absolute;
  top: 55px;
  right: 0;
  bottom: 0;
  left: 0;
  height: 100vh;
  background-color: rgba(0, 0, 0, 0.7);
}
@keyframes loader-spin {
  100% {
    transform: rotate(360deg);
  }
}
@-moz-keyframes loader-spin {
  100% {
    -moz-transform: rotate(360deg);
  }
}
@-webkit-keyframes loader-spin {
  100% {
    -webkit-transform: rotate(360deg);
  }

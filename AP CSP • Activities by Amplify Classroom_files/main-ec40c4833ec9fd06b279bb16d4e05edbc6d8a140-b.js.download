  justify-content: flex-end;
  height: 80px;
  box-shadow: 0 2px 4px 0 rgba(0, 0, 0, 0.11);
  padding: 0 32px;
  gap: 40px;
}
@media (max-width: 600px) {
  .amp-nav.kids-nav .kids-nav-banner {
    gap: 20px;
    padding: 0 10px;
  }
}
.amp-nav.kids-nav .kids-nav-banner .unav-button {
  width: 56px;
  height: 56px;
  border: solid 5px #006fe4;
  border-radius: 30px;
  display: inline-flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 3px 0 0 rgba(38, 78, 149, 0.25);
  background-color: #e1e8f9;
  flex: 0 0 auto;
  box-sizing: border-box;
}
.amp-nav.kids-nav .kids-nav-banner .unav-button:hover, .amp-nav.kids-nav .kids-nav-banner .unav-button.selected:active {
  cursor: pointer;
  background-color: #c8d6f7;
}
.amp-nav.kids-nav .kids-nav-banner .unav-button:active, .amp-nav.kids-nav .kids-nav-banner .unav-button.selected {
  border: none;
  background-color: #006fe4;
}
.amp-nav.kids-nav .kids-nav-banner .unav-button:active .icon-default, .amp-nav.kids-nav .kids-nav-banner .unav-button.selected .icon-default {
  display: none;
}
.amp-nav.kids-nav .kids-nav-banner .unav-button:active .icon-active, .amp-nav.kids-nav .kids-nav-banner .unav-button.selected .icon-active {
  display: flex;
}
.amp-nav.kids-nav .kids-nav-banner .unav-button.selected:hover:not(:active) {
  background-color: #014C9C;
  border-color: #014C9C;
}
.amp-nav.kids-nav .kids-nav-banner .unav-button:active {
  transform: translateY(2px);
  box-shadow: none;
}
.amp-nav.kids-nav .kids-nav-banner .unav-button.selected:active .icon-default {
  display: flex;
}
.amp-nav.kids-nav .kids-nav-banner .unav-button.selected:active .icon-active {
  display: none;
}
.amp-nav.kids-nav .kids-nav-banner .unav-button:focus, .amp-nav.kids-nav .kids-nav-banner .unav-button:focus-visible {
  box-shadow: 0 0 0 3px #fff, 0 0 0 8px #9c0d63;
  outline: none;
  border-color: #e1e8f9;
}
.amp-nav.kids-nav .kids-nav-banner .unav-button:focus:not(:focus-visible) {
  box-shadow: none;
}
.amp-nav.kids-nav .kids-nav-banner .unav-button.unav-mega-menu-button, .amp-nav.kids-nav .kids-nav-banner .unav-button.unav-mega-menu-button.selected:active {
  border: solid 5px #f98900;
  background-color: #ffc700;
}
.amp-nav.kids-nav .kids-nav-banner .unav-button.unav-mega-menu-button.selected, .amp-nav.kids-nav .kids-nav-banner .unav-button.unav-mega-menu-button.selected:active.selected {
  border: none;
  background-color: #006fe4;
}
.amp-nav.kids-nav .kids-nav-banner .unav-button.unav-mega-menu-button.selected .icon-default, .amp-nav.kids-nav .kids-nav-banner .unav-button.unav-mega-menu-button.selected:active.selected .icon-default {
  display: none;
}
.amp-nav.kids-nav .kids-nav-banner .unav-button.unav-mega-menu-button.selected .icon-active, .amp-nav.kids-nav .kids-nav-banner .unav-button.unav-mega-menu-button.selected:active.selected .icon-active {
  display: flex;
}
.amp-nav.kids-nav .kids-nav-banner .unav-button.unav-mega-menu-button:hover {
  background-color: #ffb300;
}
.amp-nav.kids-nav .kids-nav-banner .unav-button.unav-mega-menu-button:active {
  background-color: #006fe4;
}
.amp-nav.kids-nav .kids-nav-banner .unav-button > * {
  pointer-events: none;
}
.amp-nav.kids-nav .kids-nav-banner .unav-button .inner-wrapper {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  border-radius: 30px;
}
.amp-nav.kids-nav .kids-nav-banner .unav-button .icon-active {
  display: none;
}
.amp-nav.kids-nav .kids-nav-banner .unav-button .unav-backpack-green-icon, .amp-nav.kids-nav .kids-nav-banner .unav-button .unav-backpack-orange-icon {
  width: 32px !important;
  height: 34px !important;
}
.amp-nav.kids-nav .kids-nav-banner .unav-button .unav-key-icon, .amp-nav.kids-nav .kids-nav-banner .unav-button .unav-key-light-icon {
  width: 62px !important;
  height: 65px !important;
}
.amp-nav.kids-nav .kids-nav-banner .unav-user {
  margin-right: auto;
  margin-left: -20px;
  font-size: 2em;
  text-overflow: ellipsis;
  overflow-x: hidden;
  white-space: nowrap;
  font-family: "QuicksandBold", system-ui;
}

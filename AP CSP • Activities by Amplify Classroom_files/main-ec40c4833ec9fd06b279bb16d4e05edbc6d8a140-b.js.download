(0,-5a\\left\\{t_{0}=0\\right\\}\\right)",angle:"\\frac{\\pi}{2}",foreground:!0},{type:"image",id:"235",folderId:"262",image_url:"https://uploads.desmos.com/calculator-images/a93f404f6aa0b41774f56ca643fd1ccb",name:"03 PurpleT.png",height:"7.1a",width:"10a",center:"\\left(0,T_{urtleX}\\left(t_{0}\\right)-5a\\right)",angle:"\\frac{\\pi}{2}",foreground:!0},{type:"folder",id:"343",title:"Masking Screen",hidden:!0,collapsed:!0},{type:"image",id:"344",folderId:"343",image_url:"https://uploads.desmos.com/calculator-images/498964588f3acdcc97ecfa3d5b0797ad",name:"01 Background.png",height:"v_{h}",width:"v_{w}",center:"\\left(v_{x},v_{y}\\right)",angle:"-\\frac{\\pi}{2}",opacity:.6,foreground:!0,stringOpacity:"0.6"},{type:"folder",id:"333",title:"Snake Shape Equations",hidden:!0,collapsed:!0},{type:"expression",id:"334",folderId:"333",color:"#2d70b3",latex:"Y\\left(t,l_{ength},y_{center}\\right)=-2l_{ength}\\cdot\\operatorname{abs}\\left(t-.5\\right)+\\frac{l_{ength}}{2}+y_{center}",hidden:!0},{type:"expression",id:"360",folderId:"333",color:"#2d70b3",latex:"y=Y\\left(t,L_{ength}\\left[4\\right],Y_{snake}\\left[4\\right]\\right)",hidden:!0},{type:"expression",id:"361",folderId:"333",color:"#388c46",latex:"L_{ength}\\left[4\\right]"},{type:"expression",id:"335",folderId:"333",color:"#000000",latex:"X\\left(t,s_{quiggleFreq}\\right)=.1\\sin\\left(7s_{quiggleFreq}t\\right)",hidden:!0},{type:"expression",id:"336",folderId:"333",color:"#388c46",latex:"t_{hickness}=0.076\\cdot\\left[1,1,.6,1.2,1,1\\right]",slider:{hardMin:!0,hardMax:!0,min:"0",max:".5"}},{type:"expression",id:"337",folderId:"333",color:"#2d70b3",latex:"d_{x}\\left(t\\right)=\\operatorname{median}\\left(2\\cdot\\sin\\left(2\\pi t\\right),1,-1\\right)",hidden:!0},{type:"expression",id:"338",folderId:"333",color:"#2d70b3"},{type:"expression",id:"339",folderId:"333",color:"#7dd862",latex:"\\left(Y\\left(\\operatorname{mod}\\left(t,1\\right),L_{ength}\\left[\\operatorname{floor}\\left(\\frac{t}{3}\\right)+1\\right],Y_{snake}\\left[\\operatorname{floor}\\left(\\frac{t}{3}\\right)+1\\right]\\right)+16\\left(\\operatorname{mod}\\left(\\operatorname{floor}\\left(t\\right),3\\right)-1\\right),X_{snake}\\left[\\operatorname{floor}\\left(\\frac{t}{3}\\right)+1\\right]+X\\left(Y\\left(\\operatorname{mod}\\left(t,1\\right),L_{ength}\\left[\\operatorname{floor}\\left(\\frac{t}{3}\\right)+1\\right],Y_{snake}\\left[\\operatorname{floor}\\left(\\frac{t}{3}\\right)+1\\right]\\right),F_{req}\\left[\\operatorname{floor}\\left(\\frac{t}{3}\\right)+1\\right]\\right)+t_{hickness}\\left[\\operatorname{floor}\\left(\\frac{t}{3}\\right)+1\\right]\\cdot d_{x}\\left(\\operatorname{mod}\\left(t,1\\right)\\right)\\right)",parametricDomain:{max:"18",min:"0"},lines:!1,fill:!0,domain:{min:"0",max:"18"},stringFillOpacity:"1"},{type:"expression",id:"358",folderId:"333",color:"#054920",latex:"\\left(Y\\left(\\operatorname{mod}\\left(t,1\\right),L_{ength}\\left[\\operatorname{floor}\\left(\\frac{t}{3}\\right)+1\\right],Y_{snake}\\left[\\operatorname{floor}\\left(\\frac{t}{3}\\right)+1\\right]\\right)+16\\left(\\operatorname{mod}\\left(\\operatorname{floor}\\left(t\\right),3\\right)-1\\right),X_{snake}\\left[\\operatorname{floor}\\left(\\frac{t}{3}\\right)+1\\right]+X\\left(Y\\left(\\operatorname{mod}\\left(t,1\\right),L_{ength}\\left[\\operatorname{floor}\\left(\\frac{t}{3}\\right)+1\\right],Y_{snake}\\left[\\operatorname{floor}\\left(\\frac{t}{3}\\right)+1\\right]\\right),F_{req}\\left[\\operatorname{floor}\\left(\\frac{t}{3}\\right)+1\\right]\\right)+t_{hickness}\\left[\\operatorname{floor}\\left(\\frac{t}{3}\\right)+1\\right]\\cdot d_{x}\\left(\\operatorname{mod}\\left(t,1\\right)\\right)\\right)",parametricDomain:{max:"18",min:""},domain:{min:"0",max:"18"}},{type:"folder",id:"275",title:"Snakes",hidden:!0,collapsed:!0},{type:"expression",id:"280",folderId:"275",color:"#c74440",latex:"X_{snake}=\\left[1,1,3,5,7,7\\right]"},{type:"expression",id:"294",folderId:"275",color:"#2d70b3",latex:"Y_{start}=\\left[9,1,12.5,3,11,3\\right]"},{type:"expression",id:"292",folderId:"275",color:"#388c46",latex:"s_{peed}=\\left[2,2,-1,3,-0.75,-0.75\\right]"},{type:"expression",id:"354",folderId:"275",color:"#6042a6",latex:"D_{irection}=\\left[1,1,-1,1,-1,-1\\right]"},{type:"expression",id:"287",folderId:"275",color:"#6042a6",latex:"Y_{snake}=\\operatorname{mod}\\left(Y_{start}+s_{peed}\\cdot t_{0},16\\right)-8"},{type:"expression",id:"317",folderId:"275",color:"#000000",latex:"Y_{snake}\\left[1\\right]"},{type:"expression",id:"282",folderId:"275",color:"#388c46",latex:"L_{ength}=\\left[3,4,2,4.5,4,2\\right]"},{type:"expression",id:"326",folderId:"275",color:"#2d70b3",latex:"F_{req}=\\left[.7,.9,.9,.75,.9,1\\right]"},{type:"folder",id:"35",title:"Turtle Sizer",hidden:!0,collapsed:!0},{type:"expression",id:"7",folderId:"35",color:"#388c46",latex:"a=0.175",hidden:!0,slider:{hardMin:!0,hardMax:!0,min:"0",max:"1"}},{type:"folder",id:"218",title:"Turtle Walking Helpers",hidden:!0,collapsed:!0},{type:"expression",id:"221",folderId:"218",color:"#6042a6",latex:"x_{c1}\\left(x\\right)=.3a+s_{tep}\\left(\\frac{x+.3\\cdot.8}{.6}\\right)-.3\\cdot.8-5a-.1"},{type:"expression",id:"240",folderId:"218",color:"#6042a6",latex:"x_{c2}\\left(x\\right)=.3a+s_{tep}\\left(\\frac{x}{.6}\\right)-5a-.1"},{type:"expression",id:"239",folderId:"218",color:"#6042a6",latex:"x_{c3}\\left(x\\right)=-4.7a+s_{tep}\\left(\\frac{x+.3}{.6}\\right)-.3-5a-.1"},{type:"expression",id:"238",folderId:"218",color:"#6042a6",latex:"x_{c4}\\left(x\\right)=-4.7a+s_{tep}\\left(\\frac{x+.3\\cdot.2}{.6}\\right)-.3\\cdot.2-5a-.1"},{type:"expression",id:"222",folderId:"218",color:"#2d70b3",latex:"y_{c1}=3a"},{type:"expression",id:"242",folderId:"218",color:"#2d70b3",latex:"y_{c2}=-3a"},{type:"expression",id:"243",folderId:"218",color:"#388c46",latex:"y_{c3}=-2a"},{type:"expression",id:"244",folderId:"218",color:"#6042a6",latex:"y_{c4}=2a"},{type:"expression",id:"224",folderId:"218",color:"#000000",latex:"s_{pacing}=3"},{type:"expression",id:"
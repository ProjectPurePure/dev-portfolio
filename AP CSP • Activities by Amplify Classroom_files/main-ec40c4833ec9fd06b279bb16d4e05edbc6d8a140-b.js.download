yAxisLabel: "Distance From Water (ft.)"`,hideResponsesFromDashboard:!0}}]}}]}},title:"Reveal",script:`subtitle: "Press play to see what Luca's turtle did."`,advancedLayout:!0},{type:"two-column",id:"19a3d84c-4792-4183-852a-fede490d299b",teacherTips:{"teacher-moves":{schemaKey:"document",version:1,content:{type:"doc",content:[{type:"paragraph",content:[{type:"text",text:"Give one minute of quiet think-time. Then ask students to discuss with a partner. Highlight unique answers to show the class. Ask students to justify their responses and critique each other's reasoning. "}]},{type:"paragraph"},{type:"paragraph",content:[{type:"text",text:"Consider displaying Luca\u2019s graph while discussing these responses."}]}]}},"sample-responses":{schemaKey:"document",version:1,content:{type:"doc",content:[{type:"paragraph",content:[{type:"text",text:"1. "},{type:"mq",content:[{type:"text",text:"10"}]},{type:"text",text:" feet"}]},{type:"paragraph",content:[{type:"text",text:"2. "},{type:"mq",content:[{type:"text",text:"5"}]},{type:"text",text:" seconds"}]}]}},"student-support":null},root:{linearlayout:{mainType:"columns",components:[{linearlayout:{mainType:"rows",components:[{sketch:{version:2,background:{type:"graph"},id:"86ca2736-b4cc-436e-9277-50023aff4bca",img:"https://uploads.desmos.com/activitybuilder/3f8734c8ef95952977b85de4f434fa49",calculatorState:{version:7,graph:{viewport:{xmin:-1.8,ymin:1.1325,xmax:12,ymax:9.0675},xAxisStep:4,yAxisStep:4,xAxisLabel:"Time (sec.)",yAxisLabel:"Distance (ft.)",restrictGridToFirstQuadrant:!0},randomSeed:"2103135c1632e55dc616671cf8c0ec5f",expressions:{list:[{type:"expression",id:"41",color:"#fa7e19",latex:"T_{urtleX}\\left(t\\right)=\\left\\{0\\le t<2:t,2\\le t<4:2,4\\le t<8.5:2\\left(t-4\\right)+2,t\\ge8.5:11\\right\\}",lineWidth:"4"}]}},script:`initialColor: colors.black

yAxisLabel: "Distance From Water (ft.)"`,enabledTools:null}}]}},{linearlayout:{mainType:"rows",components:[{"exhibit/text":{text:"Here is Luca's graph. Use the graph to answer the following questions:\n\n1. What is the turtle's distance from the water at `8` seconds?\n\n2. When is the turtle's distance from the water `4` feet?",id:"5cbcdb86-e879-43c7-bbd6-400b9a1ea86e"}},{"input/text":{showPeerResponses:!1,id:"5c9056ed-65e9-4cc0-bb0a-3ce38d506b9c",script:`initialText: "1. 

2. "`}}]}}]}},title:"Interpret the Graph"},{type:"two-column",id:"881602dd-f9d5-43db-8644-3292a7f6c05f",teacherTips:{"teacher-moves":{schemaKey:"document",version:1,content:{type:"doc",content:[{type:"paragraph",content:[{type:"text",text:"Give one minute of quiet think-time. Then ask students to discuss with a partner. Highlight unique answers to show the class. Ask students to justify their responses and critique each other's reasoning."}]},{type:"paragraph"},{type:"paragraph",content:[{type:"text",text:"It's okay to lack consensus during this discussion on Screen 5. The reveal on Screen 6 will build towards consensus."}]},{type:"paragraph"},{type:"paragraph",content:[{type:"text",text:"Consider using pacing to restrict students to Screens 5\u20136."}]}]}},"sample-responses":{schemaKey:"document",version:1,content:{type:"doc",content:[{type:"paragraph",content:[{type:"text",marks:[{type:"em"}],text:"Responses vary."}]},{type:"paragraph"},{type:"paragraph",content:[{type:"text",text:"\u2022 The turtle walks forward, then splits into two turtles with one walking forward and one walking backward, then merges back into one turtle that continues walking forward."}]},{type:"paragraph"},{type:"paragraph",content:[{type:"text",text:"\u2022 The turtle begins "},{type:"mq",content:[{type:"text",text:"3"}]},{type:"text",text:" feet away from the water, walks forward "},{type:"mq",content:[{type:"text",text:"2"}]},{type:"text",text:" feet over "},{type:"mq",content:[{type:"text",text:"3"}]},{type:"text",text:" seconds, and splits into two turtles, which move in opposite directions for "},{type:"mq",content:[{type:"text",text:"3"}]},{type:"text",text:" seconds before they move toward each other for "},{type:"mq",content:[{type:"text",text:"3"}]},{type:"text",text:" seconds. The turtles then merge back into a single turtle that walks from "},{type:"mq",content:[{type:"text",text:"5"}]},{type:"text",text:" feet to "},{type:"mq",content:[{type:"text",text:"7"}]},{type:"text",text:" feet over "},{type:"mq",content:[{type:"text",text:"3"}]},{type:"text",text:" seconds."}]}]}},"student-support":null},root:{linearlayout:{mainType:"columns",components:[{linearlayout:{mainType:"rows",components:[{sketch:{version:2,background:{type:"graph"},id:"ef5ca47a-e223-45dc-8748-fcef0bd6a667",img:"https://uploads.desmos.com/activitybuilder/e0932ec047cfe5c7e7605bf614efc436",calculatorState:{version:7,graph:{viewport:{xmin:-1.8,ymin:-1.8,xmax:12,ymax:12},xAxisStep:4,yAxisStep:4,xAxisLabel:"Time (sec.)",yAxisLabel:"Distance (ft.)",restrictGridToFirstQuadrant:!0,squareAxes:!1},randomSeed:"2103135c1632e55dc616671cf8c0ec5f",expressions:{list:[{type:"expression",id:"40",color:"#6042a6",latex:"\\left(6+3\\cos2\\pi t,5+3\\sin2\\pi t\\right)",lineWidth:"4"},{type:"expression",id:"41",color:"#6042a6",latex:"\\left(0+3t,3+2t\\right)",lineWidth:"4"},{type:"expression",id:"42",color:"#6042a6",latex:"\\left(9+3t,5+2t\\right)",lineWidth:"4"},{type:"expression",id:"43",color:"#388c46",latex:"f\\left(x\\right)=\\left\\{0\\le x<3:4+\\frac{2}{3}x,3\\le x<9:\\left[\\sqrt{9-\\left(x-6\\right)^{2}}+6,-\\sqrt{9-\\left(x-6\\right)^{2}}+6\\right],9\\le x\\le12:\\frac{2}{3}x\\right\\}-1",hidden:!0}]}},script:`initialColor: colors.black

yAxisLabel: "Distance From Water (ft.)"`,alias:"sketch7",enabledTools:null}}]}},{linearlayout:{mainType:"rows",components:[{"exhibit/text":{text:`Arnav drew this graph to represent a new turtle.

What story does the graph tell about the turtle's journey?`,id:"8bb795b6-698d-4fb9-afca-9df252dade32"}},{"input/text":{showPeerResponses:!0,id:"e43d8c08-c33e-4671-90ef-691ba9df2b8f",script:""}}]}}]}},title:"Arnav's Graph"},{type:"two-column",id:"cbe64158-7402-48ca-a460-4d1ba48a96c3",teacherTips:{"teacher-moves":{schemaKey:"document",version:1,content:{type:"doc",content:[{type:"paragraph",content:[{type:"text",text:"Consider asking, \u201CDoes this graph represent a possible journey for the turtle?\u201D [No, it does not. It shows that the turtle is in two places at once for half of the journey.]"}]}]}}},root:{linearlayout:{mainType:"columns",components:[{linearlayout:{mainType:"rows",components:[{"input/graph":{exhibitMode:!0,id:"a110acbe-d0dc-47f7-85ab-e06e91092ae1",img:"https://uploads.desmos.com/activitybuilder/c3531ce9393e9ce84ab0ef73efd6e790",calculatorState:{version:7,graph:{viewport:{xmin:-7.45,ymin:-2.9,xmax:7.45,ymax:12},showGrid:!1,showXAxis:!1,showYAxis:!1,squareAxes:!1},randomSeed:"7f7b3cdaefbb3cef9f4b06ff9827d4c1",expressions:{list:[{type:"expression",id:"36",color:"#6042a6",latex:"t_0=0",hidden:!0,slider:{hardMin:!0,hardMax:!0,animationPeriod:11428.5714285714,loopMode:"LOOP_FORWARD",min:"0",max:"\\frac{4}{.35}"}},{type:"folder",id:"307",title:"Viewport+",hidden:!0,collapsed:!0},{type:"expression",id:"308",folderId:"307",color:"#000000",latex:"\\operatorname{polygon}\\left(\\left[x_m,\\ x_m,\\ x_M,\\ x_M\\right],\\ \\left[y_m,\\ y_M,\\ y_M\\ ,\\ y_m\\right]\\right)",lineStyle:"DASHED",fill:!1},{type:"expression",id:"309",folderId:"307",color:"#388c46",latex:"x_{m}=-\\frac{v_{h}}{2}",hidden:!0},{type:"expression",id:"310",folderId:"307",color:"#6042a6",latex:"x_{M}=\\frac{v_{h}}{2}",hidden:!0,slider:{hardMin:!0,min:"x_m"}},{type:"expression",id:"311",folderId:"307",color:"#000000",latex:"y_{m}=-2.9",hidden:!0,slider:{hardMax:!0,max:"-2"}},{type:"expression",id:"312",folderId:"307",color:"#c74440",latex:"y_{M}=12",hidden:!0,slider:{hardMin:!0,min:"y_{m}"
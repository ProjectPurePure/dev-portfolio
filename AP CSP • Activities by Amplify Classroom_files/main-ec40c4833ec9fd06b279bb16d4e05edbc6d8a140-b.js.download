  width: 100%;
  position: absolute;
  overflow-y: auto;
  transform: translateY(-100%);
  background-color: #fff;
  top: 0;
  transition: transform var(--amp-nav-transition-duration);
}
.amp-nav.kids-nav .kids-mega-menu.menu-open {
  transform: translateY(80px);
  max-height: 538px;
}
.amp-nav.kids-nav .kids-mega-menu .kids-mega-menu-assets {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  max-width: 800px;
  margin: 0 auto;
  justify-content: center;
}
@media (max-width: 979px) {
  .amp-nav.kids-nav .kids-mega-menu .kids-mega-menu-assets {
    padding: 0 50px;
  }
}
.amp-nav.kids-nav .kids-mega-menu .kids-mega-menu-assets a {
  display: grid;
  grid-template-rows: 142px 1fr;
  justify-items: center;
  text-align: center;
  width: 160px;
  height: 230px;
  text-decoration: none;
  flex: 0 0 auto;
  transition: background-color var(--amp-nav-transition-duration), border-color var(--amp-nav-transition-duration);
}
.amp-nav.kids-nav .kids-mega-menu .kids-mega-menu-assets a:focus {
  outline: none;
}
.amp-nav.kids-nav .kids-mega-menu .kids-mega-menu-assets a:hover, .amp-nav.kids-nav .kids-mega-menu .kids-mega-menu-assets a:focus {
  background: #e1e8f9;
}
.amp-nav.kids-nav .kids-mega-menu .kids-mega-menu-assets a:hover img, .amp-nav.kids-nav .kids-mega-menu .kids-mega-menu-assets a:focus img {
  border-radius: 50%;
}
.amp-nav.kids-nav .kids-mega-menu .kids-mega-menu-assets a:active {
  background: #d5dced;
}
.amp-nav.kids-nav .kids-mega-menu .kids-mega-menu-assets a:active .asset-img-wrapper {
  outline: none;
}
.amp-nav.kids-nav .kids-mega-menu .kids-mega-menu-assets a:hover .asset-img-wrapper, .amp-nav.kids-nav .kids-mega-menu .kids-mega-menu-assets a:focus .asset-img-wrapper {
  padding: 5px;
  border-color: #9c0d63 !important;
}
.amp-nav.kids-nav .kids-mega-menu .kids-mega-menu-assets .asset-img-wrapper {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  border: 5px solid;
  overflow: hidden;
  align-self: center;
}
.amp-nav.kids-nav .kids-mega-menu .kids-mega-menu-assets img {
  width: 100%;
  height: 100%;
}
.amp-nav.kids-nav .kids-mega-menu .kids-mega-menu-assets p {
  font-size: 24px;
  font-family: "QuicksandBold";
  color: #383838;
  line-height: 1;
  margin: 0;
}
.amp-nav.kids-nav .kids-mega-menu .kids-mega-menu-close {
  position: absolute;
  right: 12px;
  top: 12px;
}
.amp-nav.kids-nav .kids-mega-menu .kids-mega-menu-close .amp-nav-btn-icon-ghost {
  background-color: #e1e8f9;
  border: solid 5px #006fe4;
  box-shadow: 0 3px 0 0 rgba(38, 78, 149, 0.25);
  align-items: center;
  border-radius: 2.625em;
  display: inline-flex;
  justify-content: center;
  font-family: "BentonSansMedium";
  font-size: 1em;
  height: 56px;
  width: 56px;
  padding: 0;
  position: relative;
  font-weight: 400;
  text-align: center;
  white-space: nowrap;
  vertical-align: middle;
  transition: color var(--amp-nav-transition-duration), background-color var(--amp-nav-transition-duration), border-color var(--amp-nav-transition-duration), box-shadow var(--amp-nav-transition-duration);
}
.amp-nav.kids-nav .kids-mega-menu .kids-mega-menu-close .amp-nav-btn-icon-ghost:hover, .amp-nav.kids-nav .kids-mega-menu .kids-mega-menu-close .amp-nav-btn-icon-ghost:focus {
  border-color: #e1e8f9;
  background-color: #e1e8f9;
  box-shadow: 0 0 0 3px #fff, 0 0 0 8px #9c0d63;
  outline: none;
  cursor: pointer;
}
.amp-nav.kids-nav .kids-mega-menu .kids-mega-menu-close .amp-nav-btn-icon-ghost label {
  line-height: 0;
  opacity: 1;
  background-color: transparent;
  width: auto;
  height: auto;
  position: static;
}
.amp-nav.kids-nav .kids-mega-menu .kids-mega-menu-close .amp-nav-btn-icon-ghost label:hover {
  cursor: pointer;
}
.amp-nav.kids-nav .kids-mega-menu .kids-mega-menu-close .amp-nav-btn-icon-ghost i {
  font-size: 2.3em;
}
.amp-nav.kids-nav .kids-mega-menu .kids-mega-menu-loader {
  width: 100%;
  display: flex;
  justify-content: center;
  padding: 40px 0;
}
.amp-nav.kids-nav .kids-mega-menu-overlay {
  position: absolute;
  top: 80px;
  right: 0;
  bottom: 0;
  left: 0;
  height: 100vh;
  background-color: rgba(0, 0, 0, 0.3);
  display: none;
}
.amp-nav.kids-nav .kids-mega-menu-overlay.menu-open {

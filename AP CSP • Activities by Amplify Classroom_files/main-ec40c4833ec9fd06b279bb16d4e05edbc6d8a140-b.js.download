[class^=icon-v2-messaging-],
[class*=" icon-v2-messaging-"] {
  position: relative;
}

[class^=icon-v2-messaging-]::after,
[class*=" icon-v2-messaging-"]::after {
  left: 0;
  position: absolute;
  top: 0;
}

.icon-v2-messaging-error::before {
  color: #db2e00;
  content: "\\e97c";
}

.icon-v2-messaging-error::after {
  color: #fff;
  content: "\\e977";
}

.icon-v2-messaging-warning::before {
  color: #d8a202;
  content: "\\e97d";
}

.icon-v2-messaging-warning::after {
  color: #fff;
  content: "\\e978";

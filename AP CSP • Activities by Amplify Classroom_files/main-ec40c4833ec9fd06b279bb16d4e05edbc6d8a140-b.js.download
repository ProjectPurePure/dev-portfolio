  height: 100%;
}

.amp-nav-profile-menu {
  width: 242px;
  display: none;
  position: absolute;
  background: #fff;
  top: 55px;
  right: 2px;
  font-family: "BentonSansRegular", sans-serif;
  color: #3b3b3b;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  border: 1px solid #e9e9e9;
  font-size: 15px;
  z-index: 1;
  list-style-type: none;
  margin: 0;
  padding: 0;
}
.amp-nav-profile-menu.opened {
  display: flex;
  flex-direction: column;
}
.amp-nav-profile-menu-email {
  padding: 20px;
  border-bottom: 1px solid #e9e9e9;
  overflow: hidden;
  text-overflow: ellipsis;
}
.amp-nav-profile-menu-header {
  padding: 0 20px 10px;
}
.amp-nav-profile-menu-item {
  border-bottom: 1px solid #e9e9e9;
  padding: 20px 20px 15px;
  line-height: 44px;
  text-decoration: none;
  display: block;
  cursor: pointer;
}
.amp-nav-profile-menu-settings, .amp-nav-profile-menu-logout {
  padding: 10px 20px;
  line-height: 44px;
  display: flex !important;
  align-items: center;
  cursor: pointer;
  text-decoration: none;
}
.amp-nav-profile-menu-item, .amp-nav-profile-menu-settings, .amp-nav-profile-menu-logout {
  color: #3b3b3b !important;
}
.amp-nav-profile-menu-item:hover, .amp-nav-profile-menu-settings:hover, .amp-nav-profile-menu-logout:hover {
  color: #9c0d63 !important;
  text-decoration: none;
}
.amp-nav-profile-menu-item:focus, .amp-nav-profile-menu-item:focus-visible, .amp-nav-profile-menu-settings:focus, .amp-nav-profile-menu-settings:focus-visible, .amp-nav-profile-menu-logout:focus, .amp-nav-profile-menu-logout:focus-visible {
  background-color: #f6f6f6;
  box-shadow: 0 0 0 2px #fff, inset 0 0 0 3px #9c0d63;
  outline: none;
}
.amp-nav-profile-menu-item:focus:not(:focus-visible), .amp-nav-profile-menu-settings:focus:not(:focus-visible), .amp-nav-profile-menu-logout:focus:not(:focus-visible) {
  background-color: transparent;
  z-index: auto;
  box-shadow: none;
}
.amp-nav-profile-menu-settings {
  border-bottom: 1px solid #e9e9e9;
}
.amp-nav-profile-menu-settings .icon-v2-settings {
  margin-right: 8px;
}
.amp-nav-profile-menu-logout {
  background: #f6f6f6;
  text-decoration: none;
}
.amp-nav-profile-menu-logout .icon-v2-log-out {
  margin-right: 8px;

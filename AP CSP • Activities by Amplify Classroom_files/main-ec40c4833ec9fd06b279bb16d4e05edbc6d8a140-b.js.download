### 358 English words, 10 English strings

ab-edit-heading-draft-title = <1>Draft</1><2>|</2>
ab-edit-label-pronunication-tips =
    <1>Dictionary Rules</1>
    <2>
    
    <3>
        Updates to the pronunciation dictionary are<4> only applied to new
        audio</4> (existing audio will not be affected).
    </3>
    <5>
        Updates to existing dictionary entries will<6> overwrite previous
        versions.</6>
    </5>
    <7>
        Updates to the<8> global dictionary</8> will affect new audio for all
        products.
    </7>
    <9>
        Please do<10> not</10> create entries for individual numbers.
    </9>
    </2>
    <11>Recommendations</11>
    <12>
    
    <13>
        If the AI is struggling to pronounce a word correctly, experiment with
        writing it out phonetically.
    </13>
    <14>
        For example:
    <15>
          <16> "read-aloud" = "reed allowed"</16><17> "pi" = "pie"</17><18>
          "amplify" = "amp-liff-eye"</18>
    </15>
    </14>
    <19>
        Note: IPA pronunciation formatting and characters are not supported at this
        time.
    </19>
    </12>
ab-edit-message-about-action-button =
    Action buttons let you control other components on the screen using Computation
    Layer.<1>{$v0}</1>
ab-edit-message-deeplink-no-screens =
    <1>Because a deeplink was added, this activity cannot contain any
    screens.</1><2>To add screens, remove the deeplink from Activity Details.</2>
ab-edit-message-delete-screens =
    <1>Before you continue</1>
    <2>
      This activity includes screens. Adding a deeplink will <3>delete those
      screens. </3>Are you sure you want to continue?
    </2>
ab-edit-message-polypad-components-learn =
    <1/>Need help figuring out which Polypad component best suits your activity?
    <2>Learn more.</2>
ab-edit-message-script-cl-replace-description = Use <1>Command/Ctrl-Z</1> to undo any single replacement in script
ab-edit-message-upload-image-file =
    
    <1>
      Upload a file.<2/>
    </1>
ab-edit-section-copy-notification =
    You just copied the <1>{$component-type}</1> component. Press <2>cmd/ctrl+v</2>
    on any screen to paste.
challenge-edit-instructions-view =
    
    <1>
      <2>On this screen, students will create challenges for each other to
      solve!</2><3>Add screens on the left for students to create and solve their
      challenge.</3>
    </1>
    <4>
    
    <5>
    
    <6>
          <7>1</7>
    <8>
            <9>Create</9>the challenge
    </8>
    </6>    
        <10>Add at least one screen students will use to set up their
        challenge.</10>
    <11>
    
    <12>
            <13>Learn more about the Challenge Creator Component</13>
    </12>
    <14>
            <15>Computation Layer Documentation</15>
    </14>
    </11>
    <16>
          <17>Note:</17> Don't forget to set preventSubmissionReason in CL if
          students need to solve their challenge before submitting.
    </16>
    </5>
    <18>
    
    <19>
          <20>2</20>
    <21>
            <22>Solve</22>the challenge
    </21>
    </19>
    <23>
          Add a final screen that students will use to solve their challenge.
          <24>One screen limit.</24>
    </23>    
        <authorSkipsResponseCheckbox/><skipResponseGalleryCheckbox/>
    </18>
    <25>
    
    <26>
          <27>3</27>
    <28>
            <29>Submit</29>to class gallery
    </28>
    </26>    
        <30>Set the thumbnails used for the challenge in the gallery and
        response.</30>
    <31>
          Challenge Thumbnail<galleryThumbnail/>
    </31>
    <32>
          Response Thumbnail<responseThumbnail/>
    </32>    
        <33>Want more customization? Set this in Computation Layer.</33>

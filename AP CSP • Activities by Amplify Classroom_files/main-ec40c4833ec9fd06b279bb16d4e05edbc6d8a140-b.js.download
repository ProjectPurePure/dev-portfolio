  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  width: 100%;
  padding: 86px 0 48px;
  position: relative;
  height: 339px;
  overflow: hidden;
  box-sizing: border-box;
}
.no-assets__loader {
  width: 100%;
  display: flex;
  justify-content: center;
  padding: 40px 0;
  position: absolute;
  left: 0;
  top: 0;
  z-index: 10;
  height: 100%;
  background-color: #fff;
}
.no-assets__loader .spinner {
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.no-assets__image {
  display: inline-block;
  max-width: 276px;
  height: auto;
}
.no-assets__message {
  font-family: "QuicksandBold";
  font-size: 24px;
  color: #383838;
  margin: 66px 0 0;
}
@media (max-width: 979px) {
  .no-assets__message {
    max-width: 586px;
    text-align: center;
  }

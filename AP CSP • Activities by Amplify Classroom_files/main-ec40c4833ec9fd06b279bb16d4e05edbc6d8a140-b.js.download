  content: "\\e976";
}

.amp-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  --amp-nav-transition-duration: 0.1s;
  background-color: white;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

:where(.amp-nav) *:focus-visible {
  outline: 0.1875em solid var(--amp-focus-color, #9c0d63);
  outline-offset: 0.125em;
}

.nav-banner {
  display: flex;
  align-items: center;
  position: relative;
  background-color: white;
  z-index: 1;
  opacity: 1;

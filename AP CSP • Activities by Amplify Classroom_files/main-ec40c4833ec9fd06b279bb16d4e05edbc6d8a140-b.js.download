  width: 28px !important;
  height: 28px !important;
}
.amp-nav.kids-nav .unav-logout-modal {
  position: absolute;
  height: 100vh;
  top: 0;
  left: 0;
  bottom: 0;
  right: 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

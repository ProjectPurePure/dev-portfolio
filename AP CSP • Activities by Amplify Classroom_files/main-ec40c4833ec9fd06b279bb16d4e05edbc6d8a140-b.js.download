yAxisLabel: "Distance From Water (ft.)"`,enabledTools:null}}]}}]}},advancedLayout:!1,title:"Warm-Up",script:`subtitle: "Draw a distance vs. time graph to represent a turtle's journey across the sand. Then press play."`,beginNewSection:null},{type:"two-column",id:"778cbb41-3a6f-439e-a574-63654bd9c0fa",teacherTips:{"teacher-moves":{schemaKey:"document",version:1,content:{type:"doc",content:[{type:"paragraph",content:[{type:"text",text:"Consider asking students, \u201CWhat is the turtle doing between "},{type:"mq",content:[{type:"text",text:"2"}]},{type:"text",text:" and "},{type:"mq",content:[{type:"text",text:"4"}]},{type:"text",text:" seconds? How do you know?\u201D [The turtle is standing still because its distance from the water is not changing.]"}]},{type:"paragraph"},{type:"paragraph",content:[{type:"text",text:"Consider using pacing to restrict students to Screens 2\u20134."}]}]}},"sample-responses":{schemaKey:"document",version:1,content:{type:"doc",content:[{type:"paragraph",content:[{type:"text",marks:[{type:"em"}],text:"Responses vary."}]},{type:"paragraph"},{type:"paragraph",content:[{type:"text",text:"\u2022 The turtle walks, stops, and then walks again."}]},{type:"paragraph"},{type:"paragraph",content:[{type:"text",text:"\u2022 The turtle begins with its nose at the edge of the water and walks towards the grass for "},{type:"mq",content:[{type:"text",text:"2"}]},{type:"text",text:" seconds at a speed of "},{type:"mq",content:[{type:"text",text:"1"}]},{type:"text",text:" foot per second. Then the turtle stops for "},{type:"mq",content:[{type:"text",text:"2"}]},{type:"text",text:" seconds. Then the turtle walks towards the grass for "},{type:"mq",content:[{type:"text",text:"4.5"}]},{type:"text",text:" seconds at a speed of "},{type:"mq",content:[{type:"text",text:"2"}]},{type:"text",text:" feet per second. After a total of "},{type:"mq",content:[{type:"text",text:"8.5"}]},{type:"text",text:" seconds, it stops on the grass, "},{type:"mq",content:[{type:"text",text:"11"}]},{type:"text",text:" feet away from the water."}]}]}},"student-support":null},root:{linearlayout:{mainType:"columns",components:[{linearlayout:{mainType:"rows",components:[{sketch:{version:2,background:{type:"graph"},id:"900d1463-6b6b-497f-8153-cb5a9e755973",img:"https://uploads.desmos.com/activitybuilder/3f8734c8ef95952977b85de4f434fa49",calculatorState:{version:7,graph:{viewport:{xmin:-1.8,ymin:1.1325,xmax:12,ymax:9.0675},xAxisStep:4,yAxisStep:4,xAxisLabel:"Time (sec.)",yAxisLabel:"Distance (ft.)",restrictGridToFirstQuadrant:!0},randomSeed:"2103135c1632e55dc616671cf8c0ec5f",expressions:{list:[{type:"expression",id:"41",color:"#fa7e19",latex:"T_{urtleX}\\left(t\\right)=\\left\\{0\\le t<2:t,2\\le t<4:2,4\\le t<8.5:2\\left(t-4\\right)+2,t\\ge8.5:11\\right\\}",lineWidth:"4"}]}},script:`initialColor: colors.black

readOnly: true


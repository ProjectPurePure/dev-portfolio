  align-items: center;
  color: #f37321;
  display: inline-flex;
  height: 1em;
}
.amplify-wordmark.wordmark-dark {
  color: #3b3b3b;
}
.amplify-wordmark.wordmark-light {
  color: #fff;
}
.amplify-wordmark svg {
  display: block;
  height: 0.95em;
  width: 3.82375em;
}

.amplify-program-wordmark {
  --amp-period-fill: transparent;
  display: inline-flex;
}
.amplify-program-wordmark .amplify-wordmark {
  flex-shrink: 0;
}
.amplify-program-wordmark .program-name {
  color: #4d4d4f;
  font-family: "amplify";
  font-weight: 200;
  letter-spacing: -0.005em;
  line-height: 0.8;
  margin-left: -0.05em;
  position: relative;
  word-spacing: -0.125em;
}

.amplify-program .amplify-logo svg, .amplify-logo.no-period svg {
  clip-path: inset(0 4% 0 0);
}

.amplify-logo {
  fill: #f37321;
  height: 1.2em;
  position: relative;
  width: 4.86em;
}
.amplify-logo svg {
  position: absolute;
}
.amplify-logo.logo-dark {
  fill: #3b3b3b;
}
.amplify-logo.logo-light {
  fill: #fff;
}
.amplify-program .amplify-logo {
  display: inline-block;
  vertical-align: top;
}

.amplify-program {
  height: 1.2em;
  line-height: 1.2em;
  position: relative;
  white-space: nowrap;
}
.amplify-program .program-name {
  color: #676767;
  display: inline-block;
  font-family: "amplify";
  font-weight: 200;
  margin-left: -0.35em;
  position: relative;
  top: -0.025em;
}

.amp-nav-links {
  height: 100%;
  display: flex;
  flex-grow: 1;
  font-size: 13px;
}
.amp-nav-links .main-nav-items-wrapper {
  display: flex;
}
.amp-nav-links .main-nav-items-wrapper.not-ready {
  visibility: hidden;
}
.amp-nav-links .main-nav-item {
  width: auto;
  max-width: 500px;
  display: flex;
}
.amp-nav-links .amp-nav-link {
  color: #3b3b3b;
  text-transform: uppercase;
  text-decoration: none;
  padding: 0 20px;
  font-family: "BentonSansMedium";
  height: 100%;
  display: flex;
  align-items: center;
}
.amp-nav-links .amp-nav-link:hover {
  background-color: #f6f6f6;
}
.amp-nav-links .amp-nav-link:active {
  filter: brightness(95%);
}
.amp-nav-links .amp-nav-link:focus, .amp-nav-links .amp-nav-link:focus-visible {
  background-color: #f6f6f6;
  box-shadow: 0 0 0 2px #fff, 0 0 0 5px #9c0d63;
  z-index: 1;
  outline: none;
}
.amp-nav-links .amp-nav-link:focus:not(:focus-visible) {
  background-color: transparent;
  z-index: auto;
  box-shadow: none;
}
.amp-nav-links .amp-nav-link.not-capitalized {
  text-transform: none;
}
.amp-nav-links .amp-nav-link .amp-nav-link-new-tab-icon {
  display: inline-block;
  margin-left: 5px;
}
.amp-nav-links .amp-nav-link-selected {
  position: relative;
}
.amp-nav-links .amp-nav-link-selected::after {
  height: 6px;
  width: 100%;
  background-color: #9c0d63;
  content: "";
  position: absolute;
  bottom: -1px;
  left: 0;
}`,{});var P4r=({items:t,userPermissions:e,matchedRoute:n,userMclassRoles:r,userRoles:i,resizedContainerRef:o})=>{let[s,a]=(0,Pt.useState)(0),l=(0,Pt.useRef)(null),c=(0,Pt.useRef)(null),u=(0,Pt.useRef)(null),d=tx(),p=X2e(t,{userRoles:i,userMclassRoles:r,userPermissions:e}),{tabLikeMainNav:h}=gv(),m=()=>{d(_2e(!0))},f=(C,x,v=!1)=>yp(void 0,void 0,void 0,function*(){yield Kf.send(Yo.selectedTabName,tV({destinationUrl:C}),VC({isRightClick:v,url:window.location.href}),x)}),{visibleItems:b,hiddenItems:y,isInitialComputing:w}=Wgn({allItems:p,resizedElementRef:o,allItemsContainerRef:c,visibleItemsContainerRef:l,hiddenItemsContainerRef:u});return(0,Ce.jsxs)("div",Object.assign({className:W2e[oa.nav],ref:c},{children:[(0,Ce.jsx)("div",Object.assign({className:Pu("main-nav-items-wrapper",{"not-ready":w}),ref:l},{children:b.map((C,x)=>"linkUrl"in C?(0,Ce.jsx)("div",Object.assign({className:"main-nav-item"},{children:(0,Ce.jsx)(lJ,{navLink:C,onNavLinkClick:m,onNavLinkXApiEvent:f,navType:oa.nav,matchedRoute:n})}),C.text+C.linkUrl):(0,Ce.jsx)("div",Object.assign({className:"main-nav-item"},{children:(0,Ce.jsx)(rmn,{item:C,itemIndex:x,isSelected:s===x,activeTabIndex:s,setActiveTabIndex:a,testId:"main-nav-tab"})}),C.text))})),(0,Ce.jsx)("div",Object.assign({className:"more-dropdown-wrapper"},{children:!!y.length&&!w&&(0,Ce.jsx)(qgn,Object.assign({theme:"light",menuRef:u},{children:y.map((C,x)=>{if("linkUrl"in C){let{linkUrl:T,isHighlighted:D}=C,V=Aut({linkUrl:T,matchedRoute:n,isHighlighted:D,ignoreBaseUrl:!!h});return(0,Ce.jsx)(kct,Object.assign({theme:"light",isSelected:V},{children:(0,Ce.jsx)("div",Object.assign({className:"main-nav-item"},{children:(0,Ce.jsx)(lJ,{navLink:C,onNavLinkClick:m,onNavLinkXApiEvent:f,navType:oa.nav,matchedRoute:n})}))}),C.text+T)}let v=b.length+x,S=s===v;return(0,Ce.jsx)(kct,Object.assign({theme:"light",isSelected:S},{children:(0,Ce.jsx)("div",Object.assign({className:"main-nav-item"},{children:(0,Ce.jsx)(rmn,{item:C,itemIndex:v,isSelected:S,activeTabI
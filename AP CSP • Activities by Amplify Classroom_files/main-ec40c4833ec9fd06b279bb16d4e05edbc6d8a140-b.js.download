  position: relative;
  width: 100px;
  height: 100%;
}
.more-dropdown.light.expanded {
  color: #9c0d63 !important;
}
.more-dropdown.dark.expanded {
  color: #fff !important;
}
.more-dropdown__btn {
  font-size: 13px;
  border: 0;
  background-color: white;
  cursor: pointer;
  padding-right: 15px !important;
}
.more-dropdown__btn.dark {
  text-transform: capitalize;
}
.more-dropdown__btn.light:hover {
  background-color: rgba(0, 0, 0, 0.04) !important;
}
.more-dropdown__btn.light:active {
  background-color: rgba(0, 0, 0, 0.09) !important;
}
.more-dropdown__btn.dark:hover {
  background-color: rgba(0, 0, 0, 0.4) !important;
}
.more-dropdown__btn.dark:active {
  background-color: rgba(0, 0, 0, 0.8) !important;
}
.more-dropdown__icon {
  margin-left: 5px;
  position: relative;
  top: -2px;
}
.more-dropdown__menu {
  visibility: hidden;
  transform: rotateX(-90deg);
  transform-origin: top center;
  transition: opacity 0.1s ease-in-out, transform 0.1s ease-in-out, visibility 0.1s ease-in-out;
  perspective: 1000px;
  margin: 0;
  padding: 0;
  background-color: #fff;
  position: absolute;
  top: 58px;
  width: max-content;
  min-width: 120px;
  border-radius: 3px;
}
.more-dropdown__menu.light {
  right: 0;
}
@media (max-width: 600px) {
  .more-dropdown__menu.light {
    right: unset;
  }
}
.more-dropdown__menu.dark {
  left: 0;
}
.more-dropdown__menu.expanded {
  visibility: visible;
  transform: rotateX(0deg);
}

.light {
  background-color: #fff;
}

.dark {
  background-color: #3b3b3b;
  color: #fff;
}`,{});var qgn=({children:t,menuRef:e,dropdownOpenXApiEventType:n=Yo.openedMainNavMoreDropdown,dropdownCloseXApiEventType:r=Yo.closedMainNavMoreDropdown,theme:i="light"})=>{let[o,s]=(0,Pt.useState)(!1),[a,l]=(0,Pt.useState)(-1),c=(0,Pt.useRef)(null),u=(0,Pt.useRef)(null),d=i==="light"?aJ[oa.nav]:aJ[oa.subnav],p=Pt.Children.map(t,(f,b)=>{if((0,Pt.isValidElement)(f))return(0,Pt.cloneElement)(f,{isFocused:b===a,theme:i,tabIndex:o?0:-1})});Eut(c,()=>{s(!1)});let h=()=>{s(!1),l(-1)},m=(f,b=!1)=>{let y=f?n:r;Kf.send(y,void 0,VC({url:window.location.href,isRightClick:b}))};return(0,Ce.jsxs)("div",Object.assign({className:Pu("more-dropdown"),ref:c,onKeyDown:f=>{var b,y;if(o)switch(f.key){case"Escape":f.preventDefault(),h(),(b=u.current)===null||b===void 0||b.focus();break;case" ":case"Enter":f.preventDefault(),f.target.click();break;case"ArrowDown":f.preventDefault(),(()=>{let w=Pt.Children.count(t);w&&l(C=>a<w-1?C+1:0)})();break;case"ArrowUp":f.preventDefault(),(()=>{let w=Pt.Children.count(t);w&&l(C=>a>0?C-1:w-1)})();break;case"Tab":h(),f.preventDefault(),(y=u.current)===null||y===void 0||y.focus()}else f.key!==" "&&f.key!=="Enter"||(f.preventDefault(),s(!0))}},{children:[(0,Ce.jsxs)("button",Object.assign({type:"button",className:Pu(d,"more-dropdown__btn",i,{"more-dropdown__expanded":o}),onClick:()=>{m(!o),s(f=>!f)},onContextMenu:()=>m(!o,!0),ref:u,"data-testid":"more-dropdown-btn","aria-expanded":o},{children:[(0,Ce.jsx)("span",Object.assign({className:"text"},{children:i==="dark"?"More":"MORE"})),(0,Ce.jsx)("i",{className:Pu("more-dropdown__icon",{"icon-v2-caret-down":!o,"icon-v2-caret-up":o}),"aria-hidden":!0})]})),(0,Ce.jsx)("ul",Object.assign({className:Pu("more-dropdown__menu",i,{expanded:o}),"data-testid":"more-dropdown-menu",ref:e},{children:p}))]}))};ph(`.more-dropdown-item {
  display: flex;
  text-align: center;
  justify-content: center;
  list-style: none;
  width: 100%;
  margin: 0 auto;
  cursor: pointer;
  position: relative;
}
.more-dropdown-item .amp-nav-link, .more-dropdown-item .subnav-link {
  justify-content: center;
  padding-top: 15px !important;
  padding-bottom: 15px !important;
  height: auto !important;
  width: 100%;
  white-space: normal;
}
.more-dropdown-item .subnav-link {
  border: 0 !important;
}
.more-dropdown-item .amp-nav-link:after {
  background-color: transparent !important;
}
.more-dropdown-item:focus-visible {
  background-color: #f6f6f6;
  z-index: 1;
  outline: 4px solid #9c0d63;
}
.more-dropdown-item:focus-visible .amp-nav-link {
  background-color: #f6f6f6;
}
.more-dropdown-item.light:hover {
  background-color: rgba(0, 0, 0, 0.04);
}
.more-dropdown-item.light:hover .amp-nav-link {
  background-color: rgba(0, 0, 0, 0) !important;
}
.more-dropdown-item.light:active {
  background-color: rgba(0, 0, 0, 0.09);
}
.more-dropdown-item.dark .subnav-link:hover, .more-dropdown-item.light .amp-nav-link:hover {
  background-color: transparent;
}
.more-dropdown-item.dark:hover {
  background-color: rgba(0, 0, 0, 0.4) !important;
}
.more-dropdown-item.dark:active, .more-dropdown-item.dark .subnav-link:active {
  background-color: rgba(0, 0, 0, 0.8) !important;
}
.more-dropdown-item.dark:focus-visible {
  background-color: #3b3b3b;
}
.more-dropdown-item.light.selected {
  position: relative;
}
.more-dropdown-item.light.selected::after {
  height: 6px;
  width: 100%;
  background-color: #9c0d63;
  content: "";
  position: absolute;
  bottom: -1px;
  left: 0;
}
.more-dropdown-item.dark.selected {
  position: relative;
}
.more-dropdown-item.dark.selected::after {
  height: 6px;
  width: 100%;
  background-color: #fff;
  content: "";
  position: absolute;

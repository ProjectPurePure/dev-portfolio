  fill: #847393;
}
.amp-nav.kids-nav .spinner .st1 {
  fill: none;
  stroke: #241e22;
  stroke-width: 0.4531;
  stroke-miterlimit: 10;
}
.amp-nav.kids-nav .spinner .st2 {
  fill: #2e1926;
}
.amp-nav.kids-nav .spinner .st3 {
  fill: #e8eaf5;
}
.amp-nav.kids-nav .spinner .st5 {
  fill: #de4c26;
}
.amp-nav.kids-nav .spinner .st6 {
  fill: none;
  stroke: #847393;
  stroke-width: 2.2655;
  stroke-linecap: round;
  stroke-miterlimit: 10;
}
.amp-nav.kids-nav .spinner .st7 {
  fill: none;
  stroke: #db6848;
  stroke-width: 0.4531;
  stroke-miterlimit: 10;
}
.amp-nav.kids-nav .spinner .st8 {
  fill: none;
  stroke: #382721;
  stroke-width: 0.4531;
  stroke-miterlimit: 10;
}
.amp-nav.kids-nav .spinner .st9 {
  fill: #7976b6;
}
.amp-nav.kids-nav .spinner .robot {
  animation: animationFramesRobot linear 4s;
  animation-iteration-count: 100;
  transform-origin: 50% 150%;
}
.amp-nav.kids-nav .spinner .hand-animation_l {
  animation: animationFramesHandL linear 8s;
  animation-iteration-count: 100;
  transform-origin: 141px 86px;
}
.amp-nav.kids-nav .spinner .hand-animation_r {
  animation: animationFramesHandR linear 8s;
  animation-iteration-count: 100;
  transform-origin: 6px 90px;
}
.amp-nav.kids-nav .spinner .mouth-animation {
  animation: animationFramesMouth linear 8s;
  animation-iteration-count: 100;
  transform-origin: 10px 5px;
}
.amp-nav.kids-nav .spinner .robot_pupil_l-animation,
.amp-nav.kids-nav .spinner .robot_pupil_r-animation {
  animation: animationFramesEyes linear 3s;
  animation-iteration-count: 100;
}
.amp-nav.kids-nav .spinner .circular-loader {
  animation: rotate_spinner_container 2s linear infinite both;
  transform-origin: center;
}
.amp-nav.kids-nav .spinner .loader-path {
  animation: rotate_circle 1.4s ease-in-out infinite both;
  fill: transparent;
  stroke: #de4c26;
  stroke-dasharray: 285;
  stroke-linecap: round;
  stroke-width: 20px;
  transform-origin: 50% 50%;
}
.amp-nav.kids-nav .spinner .spinner-text {
  font-size: 24px;
  font-family: "QuicksandBold";
  color: #383838;
  text-align: center;
}
@keyframes animationFramesRobot {
  0% {
    transform: rotate(1deg) translate(-20px, 0px);
    animation-timing-function: ease-in-out;
  }
  50% {
    transform: rotate(-1deg) translate(20px, 0px);
    animation-timing-function: ease-in-out;
  }
  100% {
    transform: rotate(1deg) translate(-20px, 0px);
    animation-timing-function: ease-in-out;
  }
}
@keyframes animationFramesRobotShadow {
  0% {
    transform: translate(-20px, 0px);
    animation-timing-function: ease-in-out;
  }
  50% {
    transform: translate(20px, 0px);
    animation-timing-function: ease-in-out;
  }
  100% {
    transform: translate(-20px, 0px);
    animation-timing-function: ease-in-out;
  }
}
@keyframes animationFramesHandL {
  0% {
    transform: rotate(-30deg);
    animation-timing-function: ease-in;
  }
  5% {
    transform: rotate(30deg);
    animation-timing-function: ease-in;
  }
  50% {
    transform: rotate(30deg);
    animation-timing-function: ease-in;
  }
  55% {
    transform: rotate(-30deg);
    animation-timing-function: ease-in;
  }
  100% {
    transform: rotate(-30deg);
    animation-timing-function: ease-in;
  }
}
@keyframes animationFramesHandR {
  0% {
    transform: rotate(30deg);
    animation-timing-function: ease-in;
  }
  5% {
    transform: rotate(-30deg);
    animation-timing-function: ease-in;
  }
  50% {
    transform: rotate(-30deg);
    animation-timing-function: ease-in;
  }
  55% {
    transform: rotate(30deg);
    animation-timing-function: ease-in;
  }
  100% {
    transform: rotate(30deg);
    animation-timing-function: ease-in;
  }
}
@keyframes animationFramesMouth {
  0% {
    transform: scaleY(0);
    animation-timing-function: ease-in-out;
  }
  5% {
    transform: scaleY(1);
    animation-timing-function: ease-in-out;
  }
  50% {
    transform: scaleY(1);
    animation-timing-function: ease-in-out;
  }
  55% {
    transform: scaleY(0);
    animation-timing-function: ease-in-out;
  }
  100% {
    transform: scaleY(0);
    animation-timing-function: ease-in-out;
  }
}
@keyframes animationFramesEyes {
  0% {
    transform: scale(1, 1);
  }
  5% {
    transform: scale(1, 0.1);
  }
  10% {
    transform: scale(1, 1);
  }
}
@keyframes rotate_spinner_container {
  0% {
    transform: rotateZ(0deg);
  }
  100% {
    transform: rotateZ(360deg);
  }
}
@keyframes rotate_circle {
  0%, 25% {
    stroke-dashoffset: 280;
    transform: rotate(0);
  }
  50%, 75% {
    stroke-dashoffset: 75;
    transform: rotate(45deg);
  }
  100% {
    stroke-dashoffset: 280;
    transform: rotate(360deg);
  }

  display: flex;
  color: #3b3b3b;
  height: 100%;
  border-left: 1px solid #e9e9e9;
  padding: 0 20px;
  font-size: 15px;
  align-items: center;
}
@media (max-width: 600px) {
  .amp-nav-program {
    padding: 0 8px;
  }
}
.amp-nav-program .program-name {
  font-family: "BentonSansRegular", sans-serif;
  overflow: hidden;
  text-overflow: ellipsis;
}
@media (max-width: 450px) {
  .amp-nav-program .program-name {
    max-width: 220px;
  }
  .amp-nav-program .program-name:hover::after {
    content: attr(data-tooltip);
    position: absolute;
    z-index: 102;
    bottom: 10px;
    left: calc(50% + 30px);
    width: max-content;
    padding: 10px;
    margin: 0;
    background-color: #fff;
    font-size: 13px;
    line-height: 20px;
    pointer-events: none;
    text-align: center;
    transform: translate(-50%, calc(100% + 4px));
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.08), 0 3px 6px rgba(0, 0, 0, 0.115);
    border-radius: 3px;
    color: #3b3b3b;
    font-family: "BentonSansMedium", sans-serif;
    font-weight: 500;
  }
}
@media (max-width: 400px) {
  .amp-nav-program .program-name {
    max-width: 170px;
  }
}
@media (max-width: 350px) {
  .amp-nav-program .program-name {
    max-width: 137px;
  }
}
.amp-nav-program .program-color-circle {
  font-size: 10px;
  margin-top: -1px;
  margin-right: 15px;
}
@media (max-width: 600px) {
  .amp-nav-program .program-color-circle {
    margin-right: 5px;
  }

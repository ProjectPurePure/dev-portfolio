.amp-nav-notification-card__header {
  margin-bottom: 5px;
}
.amp-nav-notification-card__body {
  margin: 0 0 12px 0;
}
.amp-nav-notification-card__footer {
  justify-content: space-between;
}
.amp-nav-notification-card__icon {
  position: relative;
  top: -1px;
  margin-right: 5px;
}
.amp-nav-notification-card svg.amp-nav-notification-card__icon {
  width: 24px !important;
  height: 24px !important;
}
.amp-nav-notification-card__notifications-count {
  font-size: 16px;
  line-height: 1;
}
.amp-nav-notification-card__thumbnail-container {
  margin-right: 8px;
}
.amp-nav-notification-card__thumbnail {
  width: 50px;
  height: auto;
  border-radius: 5px;
}
.amp-nav-notification-card__main-title {
  font-family: "BentonSansMedium", sans-serif;
  font-size: 16px;
  margin: 0;
  line-height: 1.25;
}
.amp-nav-notification-card__date {
  font-size: 12.5px;
  color: #676767;
}
.amp-nav-notification-card__link {
  color: #006fe4;
  text-decoration: none;
  font-size: 14px;
  border: 0.0625em solid transparent;
  border-radius: 0.1875em;
}
.amp-nav-notification-card__link:focus, .amp-nav-notification-card__link:focus-visible {
  outline: none;
  box-shadow: 0 0 0 0.125rem #fff, 0 0 0 0.3125rem #9c0d63;
  text-decoration: underline;
}
.amp-nav-notification-card__link:hover {
  text-decoration: underline;

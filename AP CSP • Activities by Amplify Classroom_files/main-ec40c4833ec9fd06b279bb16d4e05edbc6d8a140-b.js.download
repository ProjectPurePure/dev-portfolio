polygraph-dashboard-message-and-hidden-and-unapproved-students =
    + { $hiddenStudentCount ->
        [one] 1 hidden student
       *[other] { $hiddenStudentCount } hidden students
    } + { $unapprovedStudentCount ->
        [one] 1 unapproved student
       *[other] { $unapprovedStudentCount } unapproved students
    }
polygraph-dashboard-message-and-hidden-students =
    { $hiddenStudentCount ->
        [one] + 1 hidden student
       *[other] + { $hiddenStudentCount } hidden students
    }
polygraph-dashboard-message-and-unapproved-students =
    { $unapprovedStudentCount ->
        [one] + 1 unapproved student
       *[other] + { $unapprovedStudentCount } unapproved students
    }
polygraph-dashboard-message-game-in-progress = This game is in progress.
polygraph-dashboard-message-hidden-and-unapproved-students =
    { $hiddenStudentCount ->
        [one] 1 hidden student
       *[other] { $hiddenStudentCount } hidden students
    } + { $unapprovedStudentCount ->
        [one] 1 unapproved student
       *[other] { $unapprovedStudentCount } unapproved students
    }

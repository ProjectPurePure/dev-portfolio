}
.amp-nav.amp-nav-adult .settings-modal .settings-modal-overlay {
  position: absolute;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.7);
  z-index: 100;
}
.amp-nav.amp-nav-adult .settings-modal .settings-modal-content-wrapper {
  min-width: 500px;
  min-height: 300px;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #f6f6f6;
  z-index: 101;
}
.amp-nav.amp-nav-adult .settings-modal .settings-modal-close-button {

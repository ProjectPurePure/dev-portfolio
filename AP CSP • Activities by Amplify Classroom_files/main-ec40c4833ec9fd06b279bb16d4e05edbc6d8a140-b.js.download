  border-radius: 50%;
  background-color: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  font-size: 20px;
  color: #333;
  font-family: "QuicksandBold", system-ui;
  position: relative;
}
.amp-nav.kids-nav .user-circle:hover, .amp-nav.kids-nav .user-circle:focus(:focus-visible) {
  background-color: #f0f0f0 !important;
}
.amp-nav.kids-nav .user-circle:active {
  transform: none !important;
}
.amp-nav.kids-nav .user-circle:hover::after, .amp-nav.kids-nav .user-circle:focus::after {
  content: attr(title);
  position: absolute;
  bottom: -50px;
  left: 200%;
  transform: translateX(-50%);
  background: white;
  padding: 12px 20px;
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
  white-space: nowrap;
  font-size: 16px;
  font-weight: 500;
  color: #333;
  z-index: 1000;
  pointer-events: none;

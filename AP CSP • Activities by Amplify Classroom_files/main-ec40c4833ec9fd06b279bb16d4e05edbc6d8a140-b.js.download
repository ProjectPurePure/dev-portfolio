### Strings for teacher.desmos.com, student.desmos.com


### 2986 English words, 149 English strings

account-message-account-deleted =
    <1>Your account has been deleted.</1>
    <2>
      Your account will be permanently deleted in 30 days. If you change your mind,
      you can reactivate your account by logging in within 30 days.
    </2>
account-message-account-reenabled =
    
    <1>
      <2>Your account has been reactivated.</2>
    <3>
        You previously requested to delete your account, but because you logged
        back in within 30 days, we will not delete your account. Welcome back!
    </3>
    <4>
        <5>Continue to Desmos</5>
    </4>
    </1>
account-message-already-logged-in =
    You are already logged in as {$email}{"."} Please <1>log out</1> first to
    register as a new user.
account-message-class-name-edited =
    Your teacher edited your name to<1> {$v0} </1>for the class<2> {$v1}</2>{"."}
    Any changes here will not be reflected in that class.
account-message-confirm-delete =
    <1>Are you sure you want to delete your account?</1>
    <2>
      When you delete your account, <3>we will retain your data for 30 days.
      </3>You can reactivate your account at any time during those 30 days by
      logging back in. If there's something about Desmos we can improve, please
      <4>let us know.</4><5/>We will send you a link to your email address {$v0} so
      you can delete your account.
    </2>
account-message-email-verified = Email verified!<1>Your email address ({$email}) has been verified.</1>
account-message-lost-access-info = Lost access to that email? <1>Contact our support team</1>
account-prompt-create-or-sign-in =
    
    <1>
    
    <2>
        <3>Create Account</3>
    </2>  
      <4>or</4><5>Sign In</5>
    </1>
account-prompt-delete-confirmation =
    <1>Are you sure you want to delete your account?</1>
    <2>
      We will retain your data for 30 days and then it will be <3>permanently
      deleted. </3>You can reactivate your account at any time during those 30 days
      by logging back in with the email address for this account ({$email}).
    </2>
account-prompt-link-expired =
    <1>This link is no longer valid.</1><2>Please request a new account deletion
    link in your account settings.</2>
account-prompt-sign-in =
    

  align-items: center;
  color: #f37321;
  display: inline-flex;
  height: 1em;
}
.amplify-wordmark.wordmark-dark {
  color: #3b3b3b;
}
.amplify-wordmark.wordmark-light {
  color: #fff;
}
.amplify-wordmark svg {
  display: block;
  height: 0.95em;
  width: 3.82375em;
}

.amplify-program-wordmark {
  --amp-period-fill: transparent;
  display: inline-flex;
}
.amplify-program-wordmark .amplify-wordmark {
  flex-shrink: 0;
}
.amplify-program-wordmark .program-name {
  color: #4d4d4f;
  font-family: "amplify";
  font-weight: 200;
  letter-spacing: -0.005em;
  line-height: 0.8;
  margin-left: -0.05em;
  position: relative;
  word-spacing: -0.125em;
}

.amplify-program .amplify-logo svg, .amplify-logo.no-period svg {
  clip-path: inset(0 4% 0 0);
}

.amplify-logo {
  fill: #f37321;
  height: 1.2em;
  position: relative;
  width: 4.86em;
}
.amplify-logo svg {
  position: absolute;
}
.amplify-logo.logo-dark {
  fill: #3b3b3b;
}
.amplify-logo.logo-light {
  fill: #fff;
}
.amplify-program .amplify-logo {
  display: inline-block;
  vertical-align: top;
}

.amplify-program {
  height: 1.2em;
  line-height: 1.2em;
  position: relative;
  white-space: nowrap;
}
.amplify-program .program-name {
  color: #676767;
  display: inline-block;
  font-family: "amplify";
  font-weight: 200;
  margin-left: -0.35em;
  position: relative;
  top: -0.025em;
}

.amp-nav-logo-container {
  margin: 0 20px;
  display: inline-flex;
  align-items: center;
}
.amp-nav-logo-container .amp-nav-logo {
  width: 83px !important;
  height: 22px !important;
}

.amp-nav-logo-mobile-text {
  padding: 0 8px;
  margin-top: 4px;
  font-family: "amplify", serif;
  font-size: 22px;
  color: #f37321;

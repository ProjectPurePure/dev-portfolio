.amp-nav-btn {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  height: 100%;
  padding: 0 14px;
  font-family: "BentonSansMedium", sans-serif !important;
  text-transform: uppercase;
  font-size: 13.333px;
  cursor: pointer;
  color: #3b3b3b;
  transition: color 0.2s linear, background-color 0.2s linear, border-color 0.2s linear, box-shadow 0.2s linear;
  border-radius: 3px;
  text-decoration: none;
}
.amp-nav-btn:focus-visible {
  box-shadow: 0 0 0 0.125em #fff, 0 0 0 0.3125em var(--amp-focus-color, #9c0d63);
}
.amp-nav-btn:focus:not(:focus-visible) {
  box-shadow: none;
  color: #3b3b3b;
}
.amp-nav-btn:focus:not(:focus-visible):hover {
  color: #9c0d63;
}
.amp-nav-btn:hover {
  background: rgba(0, 0, 0, 0.05);
  color: #3b3b3b;
}
.amp-nav-btn i {
  margin: 0;
}
.amp-nav-btn--with-label {
  padding: 0 10px;
}
.amp-nav-btn--with-label i {
  margin: 0 8px 0 0;
}
.amp-nav-btn--selected-underline {
  position: relative;
}
.amp-nav-btn--selected-underline::after {
  height: 6px;
  width: 100%;
  background-color: #9c0d63;
  content: "";
  position: absolute;
  bottom: -1px;
  left: 0;
}
.amp-nav-btn--selected {
  color: #9c0d63;
}
.amp-nav-btn--transparent {
  background: transparent;
  border-color: transparent;
  outline: transparent;
}
.amp-nav-btn--disabled {
  pointer-events: none;
}
.amp-nav-btn--open, .amp-nav-btn--open:hover {
  color: #9c0d63;
}
.amp-nav-btn--open:focus:not(:focus-visible) {
  box-shadow: none;
  color: #9c0d63;
}
.amp-nav-btn--user-button {
  padding: 0 10px;
}
.amp-nav-btn--user-button i {
  margin-right: 8px;
}
.amp-nav-btn--user-button.with-label {
  padding: 0 20px;
}
.amp-nav-btn--user-button.with-label.trimmed {
  padding: 0 5px;
}
.amp-nav-btn--notifications-section-tab {
  min-width: 160px;
  width: 50%;
  line-height: 32px;
  border: 0;
  border-bottom: 2px solid transparent;
  background-color: rgba(0, 0, 0, 0.1);
  font-size: 12px;
  transition: background-color 0.3s, border-bottom 0.3s, box-shadow 0.3s;
}
.amp-nav-btn--notifications-section-tab:hover {
  background-color: rgba(0, 0, 0, 0.1);
  \u0441olor: #3b3b3b;
}
.amp-nav-btn--notifications-section-tab:not(:focus-visible).selected {
  border-bottom: 2px solid #9c0d63;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.12), 0 1px 3px 0 rgba(0, 0, 0, 0.07);
  background-color: #fff;
}
.amp-nav-btn--notifications-section-tab.selected {
  background-color: #fff;
}
.amp-nav-btn--close-button {
  position: absolute;
  cursor: pointer;
  padding: 0;
  height: 35px;
  border-radius: 50%;
  font-size: 16px;
}
.amp-nav-btn--close-button .icon-v2-close {
  margin: 0;
  line-height: normal;
}
.amp-nav-btn--kids-close-button {
  border: solid 5px #006fe4;
  box-shadow: 0 3px 0 0 rgba(38, 78, 149, 0.25);
  border-radius: 2.625em;
  height: 56px;
  width: 56px;
  padding: 0;
}
@media (max-width: 979px) {
  .amp-nav-btn--kids-close-button {
    width: 45px;
    height: 45px;
  }
}
.amp-nav-btn--kids-close-button:hover, .amp-nav-btn--kids-close-button:focus {
  border-color: #e1e8f9;
  background-color: #e1e8f9;
  box-shadow: 0 0 0 3px #fff, 0 0 0 8px #9c0d63;
  outline: none;
  cursor: pointer;
}
.amp-nav-btn--kids-close-button svg.kids-close-icon {
  width: 24px !important;
  height: 25px !important;
}

.un-styled-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

@font-face {
  font-family: "Amplify";
  src: url("https://learning.amplify.com/m/7958ed15e8981302/original/Amplify.woff2");
  font-style: normal;
  font-weight: normal;

  padding: 0 0 0 5px;
  text-transform: none;
}
.amp-nav.amp-nav-adult .amp-nav-breadcrumb-link img {
  height: auto;
  width: auto;
}
.amp-nav.amp-nav-adult .amp-nav-breadcrumb-link:first-of-type {
  padding-left: 0;
}
.amp-nav.amp-nav-adult .amp-nav-breadcrumb-link:hover span, .amp-nav.amp-nav-adult .amp-nav-breadcrumb-link:active span {
  text-decoration: underline;
  text-decoration-color: white;
  text-decoration-thickness: 1px;
}
.amp-nav.amp-nav-adult .amp-nav-breadcrumb-link.amp-nav-breadcrumb-link-selected {
  text-decoration: underline;
  text-decoration-color: white;
  text-decoration-thickness: 1px;
}
.amp-nav.amp-nav-adult .amp-nav-breadcrumb-link.amp-nav-breadcrumb-link-selected::after {
  content: "";
  width: 100%;
  background-color: #fff;
  position: absolute;
  bottom: 0;
  left: 0;
}
.amp-nav.amp-nav-adult .icon-v2-chevron-right {
  text-decoration: none;
  font-weight: bold;
  font-size: 1.1em;
  margin-left: 5px;
  padding: 0 5px;
}`,{});ph(`.amp-nav.amp-nav-adult {
  /* all subnav types */
}
.amp-nav.amp-nav-adult .all-subnavs-container {
  background-color: #3b3b3b;
  position: relative;
  display: flex;
  justify-content: flex-start;
  flex-grow: 1;
  padding: 0 15px;
  height: 55px;
  letter-spacing: 1px;
  /* all subnav link types */
  /* rightsubnav and subnav */
}
.amp-nav.amp-nav-adult .all-subnavs-container:empty {
  display: none;
}
.amp-nav.amp-nav-adult .all-subnavs-container .all-subnavs-link {
  font-size: 15px;
  font-family: "BentonSansRegular", sans-serif;
  color: #fff;
  text-decoration: none;
  display: flex;
  height: 100%;
  width: auto;
  align-items: center;
}
.amp-nav.amp-nav-adult .all-subnavs-container .subnav-link {
  outline: none;
  position: relative;
}
.amp-nav.amp-nav-adult .all-subnavs-container .subnav-link .text {
  white-space: nowrap;
}
.amp-nav.amp-nav-adult .all-subnavs-container .subnav-link .link-icon.right {
  margin-left: 5px;
}
.amp-nav.amp-nav-adult .all-subnavs-container .subnav-link .link-icon.left {
  margin-right: 5px;
}
.amp-nav.amp-nav-adult .all-subnavs-container .subnav-link:hover {
  background-color: #232323;
}
.amp-nav.amp-nav-adult .all-subnavs-container .subnav-link:focus {
  box-shadow: 0 0 0 2px #fff, 0 0 0 5px #9c0d63;
  z-index: 1;
  outline: none;
}
.amp-nav.amp-nav-adult .all-subnavs-container .subnav-link:focus:not(:focus-visible) {
  z-index: auto;
  box-shadow: none;
}
.amp-nav.amp-nav-adult .all-subnavs-container .subnav-link:focus-visible {
  box-shadow: 0 0 0 2px #fff, 0 0 0 5px #9c0d63;
  z-index: 1;
  outline: none;
}
.amp-nav.amp-nav-adult .all-subnavs-container .left-subnav-link {
  padding: 0 22.5px;
}
.amp-nav.amp-nav-adult .all-subnavs-container .left-subnav-link .amp-nav-link-new-tab-icon {
  display: inline-block;
  margin-left: 5px;
}
.amp-nav.amp-nav-adult .all-subnavs-container .subnav-link-selected {
  box-sizing: border-box;
  border-bottom: 6px solid white;
  border-top: 6px solid transparent;
}
.amp-nav.amp-nav-adult .all-subnavs-container .left-subnav-item {
  width: auto;
  max-width: 500px;
}
.amp-nav.amp-nav-adult .all-subnavs-container .left-subnav-item .text {
  white-space: normal;
}
.amp-nav.amp-nav-adult .left-subnav-items-container {
  display: flex;
}
.amp-nav.amp-nav-adult .left-subnav-items-container.not-ready {
  visibility: hidden;
}
.amp-nav.amp-nav-adult .left-subnav-items-wrapper {
  display: flex;
  flex-grow: 1;
}
.amp-nav.amp-nav-adult .right-subnav-wrapper {
  margin-left: auto;
}`,{});ph(`.amp-nav.amp-nav-adult {
  font-family: "BentonSansMedium", sans-serif;
}
.amp-nav.amp-nav-adult .mobile-nav-toggle {
  border: none;
  background: transparent;
  padding: 0 6px;
  cursor: pointer;
  display: flex;
  align-items: center;
  color: #3b3b3b;
  margin-right: 3px;
}
.amp-nav.amp-nav-adult .mobile-nav-toggle i {
  font-size: 22px;
}

.adult-nav-banner {
  justify-content: space-between;
  height: 55px;
  padding: 0 12px;
  background-color: white;
}

.adult-nav-left-content {
  flex-grow: 1;
}

.adult-nav-left-content, .adult-nav-right-content {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  height: 100%;
}
@media (max-width: 600px) {
  .adult-nav-left-content .amp-nav-btn, .adult-nav-right-content .amp-nav-btn {
    padding: 0 8px;
  }
}

.amp-nav-programs-app-icon {
  font-size: 2em;
}

